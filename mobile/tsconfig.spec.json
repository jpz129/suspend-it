{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "types": ["jest", "node"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
